# WordPress loads the plugin through a directory junction; the real code lives
# at the repository root (sv-core/). Without this the junction looks like a
# second, untracked copy of every plugin file.
wp-content/plugins/sv-core/

# sv-core build/tooling (repo root)
sv-core/vendor/
sv-core/assets/js/*.bundle.js
sv-core/assets/js/*.map
sv-core/.phpunit.cache/
.cache/
.env
e2e/.auth/
test-results/
playwright-report/

# WordPress core + runtime (this repo tracks only theme + sv-core)
/wp-admin/
/wp-includes/
