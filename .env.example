# Copy to .env and fill in. .env is gitignored.
# Choose the environment: Shader local (default) or the InstaWP site.
WP_BASE_URL=http://line-age.localhost
# WP_BASE_URL=https://line-age.instawp.co

# Account used by Playwright's login-once helper (e2e/auth.setup.js).
# Create it with: wp user create sv-e2e you@example.com --role=administrator
SV_E2E_USER=sv-e2e
SV_E2E_PASSWORD=
# The hosted site has its own sv-e2e account with a different password. Run the
# hosted suite with:
#   WP_BASE_URL=https://line-age.instawp.co SV_E2E_PASSWORD="$SV_E2E_PASSWORD_HOSTED" bin/verify.sh
# Reset either account with: php bin/sv-e2e-user.php sv-e2e
SV_E2E_PASSWORD_HOSTED=

# Deploy target for bin/deploy-plugin.sh (SSH from ~/.ssh/config + key).
# From the InstaWP dashboard -> SSH Access (user@host). Never commit the real value.
SV_DEPLOY_SSH=<ssh-user>@<host>
SV_DEPLOY_PATH=/web/line-age.instawp.co/public_html
SV_DEPLOY_KEY=~/.ssh/instawp_rsa
